<UserControl x:Class="CodebaseDumper.Views.Controls.FolderPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="260">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Ô nhập đường dẫn thư mục gốc -->
        <Grid Grid.Column="0">
            <!-- TextBox thực sự -->
            <TextBox x:Name="PathTextBox"
                     Text="{Binding RootPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Padding="4,0"
                     TabIndex="0"
                     VerticalContentAlignment="Center" />
            <!-- Placeholder hiển thị khi TextBox trống và không có focus -->
            <TextBlock Text="Select a project folder…"
                       IsHitTestVisible="False"
                       Foreground="Gray"
                       Padding="4,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=PathTextBox}" Value="" />
                                    <Condition Binding="{Binding IsFocused, ElementName=PathTextBox}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Nút Browse kích hoạt hộp thoại chọn thư mục -->
        <Button Grid.Column="1"
                Content="Browse..."
                Width="80"
                TabIndex="1"
                Click="BrowseButton_Click"
                KeyDown="BrowseButton_KeyDown" />
    </Grid>
</UserControl>