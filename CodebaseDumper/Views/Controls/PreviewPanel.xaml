<!-- CodebaseDumper/Views/Controls/PreviewPanel.xaml -->
<UserControl x:Class="CodebaseDumper.Views.Controls.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodebaseDumper.Views.Controls"
             xmlns:vm="clr-namespace:CodebaseDumper.ViewModels">

    <UserControl.Resources>
        <!-- Bộ chuyển đổi hiển thị thống kê -->
        <local:PreviewStatsConverter x:Key="StatsConverter" />

        <!-- Style cho panel trạng thái Idle (hiển thị khi State == Idle) -->
        <Style x:Key="IdlePanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Idle}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho panel trạng thái Scanning -->
        <Style x:Key="ScanningPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Scanning}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho vùng xem trước (hiển thị ở các trạng thái Previewed, Exporting, Done) -->
        <Style x:Key="PreviewContentStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Previewed}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Exporting}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Done}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho panel báo lỗi -->
        <Style x:Key="ErrorPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:AppState.Error}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Lớp nền chứa toàn bộ giao diện -->
    <Grid>
        <!-- 1. Trạng thái Idle: chỉ dẫn người dùng chọn thư mục -->
        <StackPanel Style="{StaticResource IdlePanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- Biểu tượng thư mục (Segoe Fluent Icons, glyph FolderOpen) -->
            <TextBlock FontFamily="Segoe Fluent Icons"
                       Text="&#xE8B7;"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <TextBlock Text="Chọn một thư mục để xem cấu trúc"
                       FontSize="14"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 2. Trạng thái Scanning: vòng quay hoặc dấu chấm chuyển động + chữ “Đang quét” -->
        <StackPanel Style="{StaticResource ScanningPanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock FontSize="14">
                <Run Text="Đang quét" />
                <Run x:Name="DotsRun" />
            </TextBlock>
        </StackPanel>

        <!-- 3. Nội dung xem trước (Previewed, Exporting, Done) -->
        <Grid Style="{StaticResource PreviewContentStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thanh thống kê: số tệp · token · kích thước -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Preview, Converter={StaticResource StatsConverter}}"
                       FontSize="12"
                       Margin="4"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

            <!-- Cây cấu trúc ASCII (selectable, monospace) -->
            <TextBox Grid.Row="1"
                     Text="{Binding Preview.AsciiTree, TargetNullValue='', FallbackValue=''}"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="12"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="Transparent" />
        </Grid>

        <!-- 4. Trạng thái lỗi: thông báo lỗi + liên kết thử lại -->
        <StackPanel Style="{StaticResource ErrorPanelStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="14"
                       TextWrapping="Wrap"
                       MaxWidth="400"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink Command="{Binding ScanCommand}">
                    <Run Text="Thử lại" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>