<Window x:Class="CodebaseDumper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodebaseDumper.Views.Controls"
        Title="CodebaseDumper"
        MinWidth="720" MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <!-- Bố cục hai cột:
         Cột trái (260px cố định): FolderPickerControl (Auto) + FilterPanel (*)
         Cột phải (co giãn):       PreviewPanel (*) + ActionBar (Auto, Task 9B) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cột trái: chọn thư mục và bộ lọc -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:FolderPickerControl Grid.Row="0" />
            <controls:FilterPanel Grid.Row="1" />
        </Grid>

        <!-- Cột phải: xem trước cây ASCII và thanh hành động -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Panel xem trước — hiển thị cây ASCII và thống kê -->
            <controls:PreviewPanel Grid.Row="0" />

            <!-- ActionBar sẽ được thêm vào Grid.Row="1" ở Task 9B -->
        </Grid>
    </Grid>
</Window>