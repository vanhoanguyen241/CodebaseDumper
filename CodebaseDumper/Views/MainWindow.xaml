<Window x:Class="CodebaseDumper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodebaseDumper.Views.Controls"
        Title="CodebaseDumper"
        MinWidth="720" MinHeight="520"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        WindowStartupLocation="CenterScreen">
    <!-- Bố cục hai cột:
         Cột trái (260px cố định) chứa các điều khiển cấu hình
         Cột phải (co giãn) sẽ chứa PreviewPanel và ActionBar trong các tác vụ sau -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Khu vực cấu hình bên trái: FolderPickerControl -->
        <controls:FolderPickerControl Grid.Column="0" />

        <!-- Khu vực chính bên phải: để trống, sẽ bổ sung sau -->
        <Grid Grid.Column="1" />
    </Grid>
</Window>